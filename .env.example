# Postgres connection string
DATABASE_URL=postgres://postgres@localhost:5432/garden
# Public URL of the app (used in emails)
APP_URL=http://localhost:3000
# Random string used to sign unsubscribe links: `openssl rand -base64 32`
AUTH_SECRET=
# Shared secret the cron job sends to /api/cron/weekly
CRON_SECRET=
# Resend (https://resend.com) API key. Leave empty in development to print emails to the console.
RESEND_API_KEY=
EMAIL_FROM="Tend Weekly <hello@tendweekly.com>"
# Anthropic API key, used to write care guides for plants not in the built-in library
ANTHROPIC_API_KEY=
